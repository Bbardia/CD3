PORT=3100

# Where the project snapshot and its history are written. Defaults to apps/api/data/.
# CD3_DATA_DIR=/var/lib/cd3

# Unset, CD3 binds 127.0.0.1 and answers only to loopback. Set it to the address people type in
# their browser to publish the instance on every interface. Comma-separate several names; use * to
# accept any hostname. A published instance has no accounts — see the README before using it.
# CD3_PUBLIC_ORIGIN=http://cd3.lan:3100
